# Firebase (Console > Configurações do projeto > Seus apps > App da Web)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Região das Cloud Functions (só Stripe; igual a setGlobalOptions em functions/src/index.ts)
VITE_FIREBASE_REGION=southamerica-east1

# Cobrança (Stripe): "true" exige assinatura ativa para jogar (precisa do Firebase)
VITE_REQUIRE_SUBSCRIPTION=false
# Domínio interno do e-mail das contas de criança (igual ao do firebase/firestore.rules e ao CHILD_EMAIL_DOMAIN das functions)
VITE_CHILD_EMAIL_DOMAIN=crianca.minelearn.app

# Domínio de produção (canonical, og:url, sitemap e robots.txt gerados no build)
VITE_SITE_URL=https://studyblock.com.br
