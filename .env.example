VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cobrança (Stripe): "true" exige assinatura ativa para jogar (precisa do Supabase)
VITE_REQUIRE_SUBSCRIPTION=false
# Domínio interno do e-mail das contas de criança (igual ao da Edge Function create-child)
VITE_CHILD_EMAIL_DOMAIN=crianca.minelearn.app

# Domínio de produção (canonical, og:url, sitemap e robots.txt gerados no build)
VITE_SITE_URL=https://studyblock.com.br
